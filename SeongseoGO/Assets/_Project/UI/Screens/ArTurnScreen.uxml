<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="ArOverlay" src="project://database/Assets/_Project/UI/Components/ArOverlay.uxml" />
    <Style src="project://database/Assets/_Project/UI/Styles/Common.uss" />
    <Style src="project://database/Assets/_Project/UI/Components/ArOverlay.uss" />
    <Style src="project://database/Assets/_Project/UI/Screens/ArTurnScreen.uss" />
    <!-- 실내 AR 찾기 · 회전: 배경은 투명. 뒤에 AR 카메라 화면이 보인다 -->
    <ui:VisualElement name="ar-turn-screen" class="screen screen--transparent ar-screen ar-screen--turn">
        <ui:VisualElement name="safe-area" class="safe-area">
            <ui:Instance template="ArOverlay" name="ar-overlay-instance" class="ar-screen__overlay" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
