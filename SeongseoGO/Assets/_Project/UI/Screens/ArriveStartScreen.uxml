<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Styles/Common.uss" />
    <Style src="project://database/Assets/_Project/UI/Screens/ArriveStartScreen.uss" />
    <ui:VisualElement name="arrive-start-screen" class="screen">
        <ui:VisualElement name="safe-area" class="safe-area">

            <!-- 상단 내비: 뒤로가기는 ScreenManager가 연결 -->
            <ui:VisualElement class="arrive-start__header">
                <ui:VisualElement name="nav-bar" class="nav-bar">
                    <ui:Label text="도착 후 시작" class="text-nav nav-bar__title" />
                    <ui:VisualElement name="back-button" class="icon-slot nav-bar__button icon--back icon-tint--strong" />
                    <ui:VisualElement class="nav-bar__button" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 건물 사진 자리 (화면 폭 전체): BuildingData.photo가 있으면 그 사진이 들어간다 -->
            <ui:VisualElement name="building-photo" class="image-slot arrive-start__photo" />

            <ui:VisualElement name="content" class="screen__content arrive-start__content">
                <ui:VisualElement class="icon-circle arrive-start__icon-circle">
                    <ui:VisualElement name="arrive-icon" class="icon-slot arrive-start__icon icon--pin icon-tint--primary" />
                </ui:VisualElement>

                <!-- 제목·설명은 ArriveStartScreenPresenter가 고른 건물·강의실 이름으로 채운다 -->
                <ui:Label name="title" text="도착하셨나요?" class="text-title arrive-start__title" />
                <ui:Label name="description" text="이제 카메라를 켜고 강의실까지&#10;AR 안내선을 따라 이동해 보세요." class="arrive-start__description" />

                <!-- 카메라 권한 안내 칩 -->
                <ui:VisualElement name="camera-chip" class="arrive-start__chip">
                    <ui:VisualElement name="camera-icon" class="icon-slot arrive-start__chip-icon icon--camera icon-tint--body" />
                    <ui:Label text="카메라 권한이 필요해요" class="text-semibold arrive-start__chip-label" />
                </ui:VisualElement>

                <ui:VisualElement class="arrive-start__spacer" />

                <!-- 시작하기 버튼 → 실내 AR (ArriveStartScreenPresenter) -->
                <ui:VisualElement name="start-button" class="btn-primary arrive-start__button">
                    <ui:Label text="시작하기" class="btn-primary__label" />
                    <ui:VisualElement name="start-icon" class="icon-slot btn-primary__icon icon--scan icon-tint--white" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
